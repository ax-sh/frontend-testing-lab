    "sass": "^1.87.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0-next.6",
    "@eslint/js": "^9.25.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-onboarding": "^9.0.0-beta.11",
    "@storybook/addon-vitest": "9.0.0-beta.11",
